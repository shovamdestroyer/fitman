# FitAI Coach & SATHI AI Environment Configuration

# Server Port
PORT=3000

# Google Gemini API Key for SATHI AI Chatbot (optional: fallback AI engine active if not set)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Authentication & PostgreSQL Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Environment
NODE_ENV=development
